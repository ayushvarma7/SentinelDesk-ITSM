# Copy to .env and fill in. .env is gitignored — never commit a real key.
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)

# --- required for drafting (P2) ---------------------------------------------
# Google AI Studio -> Get API key: https://aistudio.google.com/apikey
# Without this the pipeline still runs: generate falls back to the extractive
# path, which quotes the closest same-language precedent instead of writing.
GEMINI_API_KEY=
# --- optional overrides -----------------------------------------------------
# Gemini model used for drafts. P2.1 (scripts/check_llm.py) verifies the name
# against the live model list; change it here if it 404s.
#SD_LLM_MODEL=gemini-2.5-flash

# Encoder device. Leave unset to let sentence-transformers pick (mps on Apple
# Silicon, cuda on Colab, else cpu).
#SD_DEVICE=mps

# Dev-sized KB index for a fast smoke test. NEVER set this for a real build or
# for anything you upload — P1's classifier asserts the full 22,863 rows.
#SD_KB_LIMIT=3000

# Tickets per language in scripts/draft_eval.py (default 10 -> 20 drafts).
#SD_DRAFT_N=5
