# Copy to .env and fill in. ./run.sh loads it automatically. .env is gitignored — never commit a real key.
#   cp .env.example .env

# --- required for drafting ---------------------------------------------
# Google AI Studio -> Get API key: https://aistudio.google.com/apikey
# Without this the pipeline still runs: generate falls back to the extractive
# path, which quotes the closest same-language precedent instead of writing.
GEMINI_API_KEY=
# --- optional overrides -----------------------------------------------------
# Gemini model used for drafts. scripts/check_llm.py verifies the name
# against the live model list; change it here if it 404s.
#SD_LLM_MODEL=gemini-3.5-flash-lite

# Tickets per language in scripts/draft_eval.py (default 10 -> 20 drafts; ./run.sh eval uses 5).
#SD_DRAFT_N=5
